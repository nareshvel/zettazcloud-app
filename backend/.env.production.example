NODE_ENV=production
# Must stay false in production — with NODE_ENV=development + true, ALL RBAC checks are bypassed.
SKIP_PERMISSION_CHECKS=false
PORT=5172
DEBUG_GRN=false
DEBUG_API=false
DEBUG_SALES=false
DEBUG_REPORTS=false

# Database connection
MYSQL_HOST=localhost
MYSQL_USER=zettazcloud_systemadmin
MYSQL_PASSWORD=***REMOVED***
MYSQL_DATABASE=zettazcloud_prod

# DB pool — local MySQL on the production VPS can handle more connections
# than the old shared host. Keep the default production values unless you
# change MySQL's max_connections.
DB_CONNECTION_LIMIT=5
DB_MAX_IDLE=2
DB_IDLE_TIMEOUT=120000

# JWT Settings
JWT_SECRET=***REMOVED***

# SMTP Configuration for Email Service
# Replace with your shared hosting SMTP settings
SMTP_HOST=mail.supremecluster.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@zettaz.com
SMTP_PASS=***REMOVED***
SMTP_FROM=noreply@zettaz.com

# Frontend URL for email links
FRONTEND_URL=https://cloud.zettaz.com

# Public Signup Configuration
SIGNUP_ENABLED=true
TRIAL_DAYS=14

# Stripe Billing — Zettaz SaaS account (shared with Paytime), see
# docs/17-migration-and-roadmap/17_Stripe_Billing_Module.md
# STRIPE_SECRET_KEY intentionally left blank — get a restricted key from
# Stripe Dashboard > Developers > API keys and paste it in here.
STRIPE_SECRET_KEY=sk_live_or_test_your_key
# Live webhook endpoint we_1UAcv7DiMTz5HnMKZHKaNpIC -> https://api.zettaz.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Debug settings - keep disabled in production
DEBUG_USERS=false
DEBUG_API=false
DEBUG_REPORTS=false
DEBUG_SALES=false
DEBUG_JWT=false
DEBUG_STORE=false
DEBUG_DB=false
DEBUG_GRN=false
DEBUG=false

# CORS/Proxy
# Disable Express CORS in production; Nginx will set CORS headers
ENABLE_EXPRESS_CORS=false