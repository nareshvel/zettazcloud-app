{
  "name": "zettaz-cloud-pos-backend",
  "version": "1.0.0",
  "description": "Backend server for Zettaz Cloud POS application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --signal SIGTERM --delay 2s server.js",
    "test": "mocha tests/**/*.test.js --timeout 10000 --exit",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "migrate:dry": "node scripts/migrate.js --dry-run",
    "migrate:seeds": "node scripts/migrate.js --seeds",
    "migrate:demo": "node scripts/migrate.js --demo && node scripts/provision-demo-templates.js",
    "db:reset-demo": "node scripts/reset-to-demo.js",
    "sync:clean-invoices": "node scripts/sync-clean-invoice-templates.js",
    "sync:clean-invoices:apply": "node scripts/sync-clean-invoice-templates.js --yes",
    "provision:missing-templates:dry": "node scripts/provision-missing-print-templates.js --dry-run",
    "provision:missing-templates": "node scripts/provision-missing-print-templates.js",
    "purge:expired-stores:dry": "node scripts/purge-expired-stores.js",
    "purge:expired-stores": "node scripts/purge-expired-stores.js --execute",
    "backfill:store-listings:dry": "node scripts/backfill-store-product-listings.js",
    "backfill:store-listings": "node scripts/backfill-store-product-listings.js --execute"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.2.6",
    "dotenv": "^16.5.0",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.5",
    "escpos-serialport": "^3.0.0-alpha.4",
    "escpos-usb": "^3.0.0-alpha.4",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "mysql2": "^3.14.3",
    "nodemailer": "^9.1.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "stripe": "^17.4.0",
    "uuid": "^11.1.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/xlsx": "^0.0.35",
    "chai": "^4.3.7",
    "eslint": "^8.57.1",
    "mocha": "^12.0.0",
    "nodemon": "^3.1.10",
    "sinon": "^15.0.3",
    "supertest": "^7.1.4"
  }
}
