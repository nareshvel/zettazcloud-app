# Frontend environment variables (Vite)
# Copy to .env.local for development. NEVER commit a real .env file.
# Only variables prefixed with VITE_ are exposed to the browser bundle —
# never put a real secret here, everything in this file ships to the client.

# Base URL of the backend API server root — do NOT include /api suffix
VITE_API_BASE_URL=http://localhost:5172

# Legacy alias (same value)
VITE_API_URL=http://localhost:5172

# Used only for local JWT decode sanity checks in development.
# This is NOT a security boundary — the real secret lives on the backend.
VITE_JWT_SECRET=dev-only-not-a-secret
